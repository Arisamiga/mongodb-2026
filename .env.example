# Shared by the API and matching service. Compose overrides hostnames for its network.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=lost_found
# Replace with a random secret of at least 32 characters; never commit .env.
JWT_SECRET=
JWT_TTL_MINUTES=60
# Scores at or above this threshold auto-link users (minimum 0.90).
MATCH_THRESHOLD=0.90
AI_SERVICE_URL=http://127.0.0.1:8001
AI_EMBEDDING_PATH=/embeddings
AI_MATCHES_PATH=/matches
AI_TIMEOUT_SECONDS=30
AI_SERVICE_TOKEN=
# Required for embeddings; never commit a real key.
VOYAGE_API_KEY=
CORS_ORIGINS=["http://localhost:3000"]
# Frontend server proxy (Compose overrides this hostname).
BACKEND_URL=http://127.0.0.1:8000
# Optional: coordinate entry works without autocomplete.
GEOAPIFY_API_KEY=
