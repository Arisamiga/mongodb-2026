MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=lost_found
# Replace with a random secret of at least 32 characters; never commit .env.
JWT_SECRET=
JWT_TTL_MINUTES=60
MATCH_THRESHOLD=0.78
MATCH_DISTANCE_SCALE_KM=5
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# JSON list of allowed frontend origins. No wildcard when credentials are enabled.
CORS_ORIGINS=["http://localhost:3000"]
