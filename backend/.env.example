MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=lost_found
# Replace with a random secret of at least 32 characters; never commit .env.
JWT_SECRET=
JWT_TTL_MINUTES=60
# Scores at or above this threshold auto-link users (minimum 0.90).
MATCH_THRESHOLD=0.90
# AI container managed by the model teammate; use its Compose service name or private URL.
AI_SERVICE_URL=http://ai:8001
AI_EMBEDDING_PATH=/embeddings
AI_MATCHES_PATH=/matches
AI_TIMEOUT_SECONDS=30
AI_SERVICE_TOKEN=
# JSON list of allowed frontend origins. No wildcard when credentials are enabled.
CORS_ORIGINS=["http://localhost:3000"]
